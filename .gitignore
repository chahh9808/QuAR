# Data directories (large datasets should not be committed)
data/
# ...but robustbench/data holds the two small text files that define the 5k
# evaluation subset. Without them the shipped code cannot reproduce the protocol.
!robustbench/data/
!robustbench/data/*.txt
!robustbench/data/*.json
datasets/
*.zip
*.tar
*.tar.gz
*.rar

# Model checkpoints and weights
checkpoints/
weights/
*.pth
*.pt
# QuAR source statistics ship with the repository (about 20 MB); checkpoints do not (artifacts/MANIFEST.tsv).
!stats/qac_stats_*.pt
!stats/cls_stats_*.pt
!stats/resnet50gn_mqbench_w6a6_srcstats.pt
!stats/resnet50_mqbench_w6a6_srcstats.pt
# except the unreported 32-image variant
stats/*_src32_*.pt
*.ckpt

